{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/evidence.schema.json",
  "title": "Evidence",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "_id": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "lifecycleStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/lifecycleStatus"
    },
    "editorialStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/editorialStatus"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "retirementMode": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/retirementMode"
    },
    "retiredByDecisionId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_dec"
    },
    "supersededByIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/activeV1Id"
      },
      "uniqueItems": true
    },
    "sourceId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_src"
    },
    "assertionIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/activeV1Id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "attestation": {
      "type": "string",
      "minLength": 1
    },
    "rightsNote": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "object",
      "properties": {
        "subjectId": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/activeV1Id"
        },
        "fieldPath": {
          "type": "string",
          "pattern": "^/"
        },
        "valueDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "specificity": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/claimSpecificity"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subjectId",
        "fieldPath",
        "valueDigest",
        "specificity"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "attestationType": {
      "type": "string",
      "minLength": 1
    },
    "collectionMethod": {
      "type": "string",
      "minLength": 1
    },
    "reviewStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/evidenceReviewStatus"
    },
    "independence": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/sourceIndependence"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "_id",
    "schemaVersion",
    "lifecycleStatus",
    "editorialStatus",
    "sourceId",
    "assertionIds"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "active"
          }
        },
        "required": [
          "lifecycleStatus"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "retirementMode"
              ]
            },
            {
              "required": [
                "retiredByDecisionId"
              ]
            },
            {
              "required": [
                "supersededByIds"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "retirementMode",
          "retiredByDecisionId",
          "supersededByIds"
        ]
      }
    }
  ]
}

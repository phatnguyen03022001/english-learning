{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/lexical-sense.schema.json",
  "title": "LexicalSense",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "_id": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_sns"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "lifecycleStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/lifecycleStatus"
    },
    "editorialStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/editorialStatus"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "retirementMode": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/retirementMode"
    },
    "retiredByDecisionId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_dec"
    },
    "supersededByIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/activeV1Id"
      },
      "uniqueItems": true
    },
    "entryId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_lex"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "topicIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_top"
      },
      "uniqueItems": true
    },
    "register": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/register"
    },
    "usageNote": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "usageRestrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "description"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "contrastiveNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/languageTag"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "language",
          "text"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "grammar": {
      "type": "object",
      "properties": {
        "countability": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/countability"
        },
        "transitivity": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/transitivity"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "constructionIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_con"
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "english": {
            "type": "string",
            "minLength": 1
          },
          "exampleType": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/exampleType"
          },
          "editorialStatus": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/editorialStatus"
          },
          "translationEvidenceStatus": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/translationEvidenceStatus"
          },
          "vi": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
            },
            "uniqueItems": true
          },
          "register": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/register"
          },
          "variety": {
            "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/languageTag"
          }
        },
        "required": [
          "english",
          "exampleType",
          "editorialStatus",
          "translationEvidenceStatus"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "_id",
    "schemaVersion",
    "lifecycleStatus",
    "editorialStatus",
    "entryId",
    "definition"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "active"
          }
        },
        "required": [
          "lifecycleStatus"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "retirementMode"
              ]
            },
            {
              "required": [
                "retiredByDecisionId"
              ]
            },
            {
              "required": [
                "supersededByIds"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "retirementMode",
          "retiredByDecisionId",
          "supersededByIds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "retired"
          },
          "retirementMode": {
            "const": "semantic_split"
          }
        },
        "required": [
          "lifecycleStatus",
          "retirementMode"
        ]
      },
      "then": {
        "properties": {
          "supersededByIds": {
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_sns"
            },
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "retired"
          },
          "retirementMode": {
            "const": "semantic_merge"
          }
        },
        "required": [
          "lifecycleStatus",
          "retirementMode"
        ]
      },
      "then": {
        "properties": {
          "supersededByIds": {
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_sns"
            },
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "retired"
          },
          "retirementMode": {
            "const": "duplicate_reconciliation"
          }
        },
        "required": [
          "lifecycleStatus",
          "retirementMode"
        ]
      },
      "then": {
        "properties": {
          "supersededByIds": {
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_sns"
            },
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "retired"
          },
          "retirementMode": {
            "const": "invalidated"
          }
        },
        "required": [
          "lifecycleStatus",
          "retirementMode"
        ]
      },
      "then": {
        "properties": {
          "supersededByIds": {
            "items": {
              "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_sns"
            },
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    }
  ]
}

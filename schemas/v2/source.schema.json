{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/source.schema.json",
  "title": "Source",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "_id": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_src"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "lifecycleStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/lifecycleStatus"
    },
    "editorialStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/editorialStatus"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_evd"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "retirementMode": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/retirementMode"
    },
    "retiredByDecisionId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_dec"
    },
    "supersededByIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/activeV1Id"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "permittedUse": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/sourceType"
    },
    "sourceIdentifier": {
      "type": "string",
      "minLength": 1
    },
    "materialVersion": {
      "type": "string",
      "minLength": 1
    },
    "retrievedAt": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/sourceRightsStatus"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "licenseIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "permissionReference": {
          "type": "string",
          "minLength": 1
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "decisionId": {
          "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v2/common.schema.json#/$defs/id_dec"
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1
        },
        "revokedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "_id",
    "schemaVersion",
    "lifecycleStatus",
    "editorialStatus",
    "title"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "active"
          }
        },
        "required": [
          "lifecycleStatus"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "retirementMode"
              ]
            },
            {
              "required": [
                "retiredByDecisionId"
              ]
            },
            {
              "required": [
                "supersededByIds"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "retirementMode",
          "retiredByDecisionId",
          "supersededByIds"
        ]
      }
    }
  ]
}

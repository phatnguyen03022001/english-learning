{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/lexical-form.schema.json",
  "title": "LexicalForm",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "_id": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/id_frm"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "lifecycleStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/lifecycleStatus"
    },
    "editorialStatus": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/editorialStatus"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/id_evd"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "retirementMode": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/retirementMode"
    },
    "retiredByDecisionId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/id_dec"
    },
    "supersededByIds": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/activeV1Id"
      },
      "uniqueItems": true
    },
    "entryId": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/id_lex"
    },
    "form": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "$ref": "https://raw.githubusercontent.com/phatnguyen03022001/ielts-tradition/main/schemas/v1/common.schema.json#/$defs/languageTag"
    },
    "ipa": {
      "type": "string",
      "minLength": 1
    },
    "stress": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "_id",
    "schemaVersion",
    "lifecycleStatus",
    "editorialStatus",
    "entryId",
    "form"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycleStatus": {
            "const": "active"
          }
        },
        "required": [
          "lifecycleStatus"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "retirementMode"
              ]
            },
            {
              "required": [
                "retiredByDecisionId"
              ]
            },
            {
              "required": [
                "supersededByIds"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "retirementMode",
          "retiredByDecisionId",
          "supersededByIds"
        ]
      }
    }
  ]
}
